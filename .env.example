# OpenRouter (primary for web analyze when both keys are set)

OPENROUTER_API_KEY=

OPENROUTER_MODEL=openai/gpt-4o-mini



# Google Gemini (fallback when OpenRouter fails, or primary if LLM_PRIMARY=gemini)

GEMINI_API_KEY=

GEMINI_MODEL=gemini-flash-latest



# Provider order: auto | openrouter | gemini | openai

# LLM_PRIMARY=auto



# Optional token ceiling for OpenRouter/OpenAI paths

# OPENROUTER_MAX_TOKENS=8192



# Optional OpenRouter metadata

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OPENROUTER_HTTP_REFERER=http://localhost

# OPENROUTER_APP_TITLE=Google Photos Discovery Engine



# ngrok public tunnel (optional): scripts/start-ngrok.ps1
# NGROK_AUTHTOKEN=

# Direct OpenAI (alternative / fallback)

# OPENAI_API_KEY=

# OPENAI_MODEL=gpt-4o-mini


